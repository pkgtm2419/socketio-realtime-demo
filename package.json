{
  "name": "socketio-realtime-demo",
  "version": "1.0.0",
  "description": "High-throughput real-time telemetry streaming and notification platform built with Socket.IO, TypeScript, and Redis adapter.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest --detectOpenHandles --forceExit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "socketio",
    "websockets",
    "typescript",
    "realtime",
    "iot",
    "telemetry",
    "redis"
  ],
